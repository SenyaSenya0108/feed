###### Kafka ######
# Включаем режим KRaft (без ZooKeeper)
KAFKA_ENABLE_KRAFT=
 # Узлу назначаем две роли:
# - broker: принимает/отдаёт сообщения
# - controller: управляет метаданными кластера
KAFKA_PROCESS_ROLES=
# Имя слушателя для Raft-трафика
KAFKA_CONTROLLER_LISTENER_NAMES=
# Где брокер слушает подключения:
# - PLAINTEXT: клиентские подключения (9092)
# - CONTROLLER: Raft-трафик (9093)
KAFKA_LISTENERS=
# Протоколы для слушателей:
# Оба используют PLAINTEXT (без шифрования)
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=
# Как клиенты должны подключаться к брокеру:
# - Через имя контейнера `kafka` и порт 9092
KAFKA_ADVERTISED_LISTENERS=
# Уникальный ID брокера в кластере (должен быть числом)
KAFKA_BROKER_ID=
# Участники Raft-кворума:
# - Один узел: `kafka:9093` (сам себя)
# - `@` означает, что ID берётся из KAFKA_CFG_NODE_ID
KAFKA_CONTROLLER_QUORUM_VOTERS=
# Разрешаем незашифрованные подключения (для тестов)
ALLOW_PLAINTEXT_LISTENER=
# Уникальный ID кластера (генерируется один раз)
KAFKA_KRAFT_CLUSTER_ID=
# ID узла в Raft-кластере (совпадает с KAFKA_BROKER_ID)
KAFKA_NODE_ID=
###### Kafka ######


